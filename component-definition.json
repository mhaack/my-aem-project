                "template": {
                  "name": "Hero",
                  "model": "hero"
                }
              }
            }
          }
        },
        {
          "title": "Cards",
          "id": "cards",
          "plugins": {
            "xwalk": {
              "page": {
                "resourceType": "core/franklin/components/block/v1/block",
                "template": {
                  "name": "Cards",
                  "filter": "cards"
                }
              }
            }
          }
        },
        {
          "title": "Card",
          "id": "card",
          "plugins": {
            "xwalk": {
              "page": {
                "resourceType": "core/franklin/components/block/v1/block/item",
                "template": {
                  "name": "Card",
                  "model": "card"
                }
              }
            }
          }
        },
        {
          "title": "FAQ",
          "id": "faq",
          "plugins": {
            "xwalk": {
              "page": {
                "resourceType": "core/franklin/components/block/v1/block",
                "template": {
                  "name": "FAQ",
                  "filter": "faq",
                  "item_0": {
                    "resourceType": "core/franklin/components/block/v1/block/item",
                    "model": "faqitem",
                    "question": "What is AEM?",
                    "questionType": "h3",
                    "answer": "<p>Adobe Experience Manager (AEM) is a comprehensive content management solution for building websites, mobile apps, and forms.</p>"
                  },
                  "item_1": {
                    "resourceType": "core/franklin/components/block/v1/block/item",
                    "model": "faqitem",
                    "question": "How do I get started?",
                    "questionType": "h3",
                    "answer": "<p>You can start by exploring our documentation and following the getting started guides.</p>"
                  }
                }
              }
            }
          }
        },
        {
          "title": "FAQ Item",
          "id": "faqitem",
          "plugins": {
            "xwalk": {
              "page": {
                "resourceType": "core/franklin/components/block/v1/block/item",
                "template": {
                  "name": "FAQ Item",
                  "model": "faqitem",
                  "question": "What is the question?",
                  "questionType": "h3",
                  "answer": "This is the answer."
                }
              }
            }
          }
        }
      ]
    }
